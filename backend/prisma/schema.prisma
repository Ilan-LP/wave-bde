generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Roles {
  ADMIN
  POLE_LEAD
  MEMBRE
}

enum Poles {
  BUREAU
  COMMUNICATION
  EVENEMENT
  PARTENARIAT
  TRESORERIE
  LOGISTIQUE
}

enum NoteType {
  NOTE
  WARNING
  FELICITATION
}

enum ShiftStatus {
  OUVERT
  ASSIGNE
  CONFIRME
  ECHANGE_DEMANDE
}

enum ShiftType {
  BUVETTE
  PERMANENCE
}

enum ExchangeStatus {
  EN_ATTENTE
  ACCEPTE
  REFUSE
}

enum AvoirStatus {
  ACTIF
  CONSOMME
  EXPIRE
}

enum AvoirAction {
  CREE
  CONSULTE
  CONSOMME
  EXPIRE
}

enum EventStatus {
  IDEE
  PLANIFIE
  EN_COURS
  TERMINE
  ANNULE
}

enum TaskStatus {
  A_FAIRE
  EN_COURS
  FAIT
}

enum PartnerStatus {
  PROSPECT
  NEGOCIATION
  ACTIF
  ARCHIVE
}

enum Platform {
  INSTAGRAM
  LINKEDIN
  TIKTOK
  AUTRE
}

enum PostStatus {
  IDEE
  PLANIFIE
  PUBLIE
  ANNULE
}

enum PaymentMethod {
  ESPECES
  CB
  AVOIR
}

enum TresoType {
  RECETTE
  DEPENSE
}

model User {
  id           Int       @id @default(autoincrement())
  email        String    @unique
  passwordHash String
  firstName    String
  lastName     String
  role         Roles
  pole         Poles?
  photoUrl     String?
  bio          String?
  isActive     Boolean   @default(true)
  isPublic     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  shifts              Shift[]
  avoirsIssued        Avoir[]          @relation("IssuedBy")
  avoirsReceived      Avoir[]          @relation("IssuedTo")
  avoirsConsumedBy    Avoir[]          @relation("ConsumedBy")
  auditLogs           AuditLog[]
  memberNotes         MemberNote[]     @relation("NoteTarget")
  memberNotesAuthored MemberNote[]     @relation("NoteAuthor")
  avoirLogs           AvoirLog[]
  lockAccessLogs      LockAccessLog[]
  lockCodesUpdated    LockCode[]
  shiftExchangesReq   ShiftExchange[]  @relation("ExchangeRequester")
  shiftExchangesTgt   ShiftExchange[]  @relation("ExchangeTarget")
  stockItemsUpdated   StockItem[]
  stockMovements      StockMovement[]
  eventsResponsible   Event[]
  eventTasksAssigned  EventTask[]
  partnersResponsible Partner[]
  postsResponsible    CommunicationPost[]
  buvetteVentes       BuvetteVente[]
  tresoTransactions   TresoTransaction[]

  @@index([role])
  @@index([isActive])
}

model MemberNote {
  id              Int      @id @default(autoincrement())
  userId          Int
  authorId        Int
  type            NoteType
  content         String
  isVisibleToPole Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  deletedAt       DateTime?

  user   User @relation("NoteTarget", fields: [userId], references: [id])
  author User @relation("NoteAuthor", fields: [authorId], references: [id])

  @@index([userId])
  @@index([authorId])
}

model Shift {
  id        Int         @id @default(autoincrement())
  userId    Int?
  date      DateTime
  startTime String
  endTime   String
  status    ShiftStatus @default(OUVERT)
  type      ShiftType   @default(BUVETTE)
  note      String?
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  deletedAt DateTime?

  user               User?           @relation(fields: [userId], references: [id])
  exchangesFrom      ShiftExchange[] @relation("FromShift")
  exchangesTo        ShiftExchange[] @relation("ToShift")

  @@index([userId])
  @@index([date])
  @@index([status])
}

model ShiftExchange {
  id          Int            @id @default(autoincrement())
  requesterId Int
  targetId    Int
  fromShiftId Int
  toShiftId   Int
  status      ExchangeStatus @default(EN_ATTENTE)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  deletedAt   DateTime?

  requester User  @relation("ExchangeRequester", fields: [requesterId], references: [id])
  target    User  @relation("ExchangeTarget", fields: [targetId], references: [id])
  fromShift Shift @relation("FromShift", fields: [fromShiftId], references: [id])
  toShift   Shift @relation("ToShift", fields: [toShiftId], references: [id])

  @@index([requesterId])
  @@index([targetId])
  @@index([status])
}

model Avoir {
  id            Int         @id @default(autoincrement())
  code          String      @unique
  amountCents   Int
  status        AvoirStatus @default(ACTIF)
  issuedToId    Int?
  issuedById    Int
  externalName  String?
  externalEmail String?
  reason        String?
  expiresAt     DateTime?
  consumedAt    DateTime?
  consumedById  Int?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  deletedAt     DateTime?

  issuedTo   User?     @relation("IssuedTo", fields: [issuedToId], references: [id])
  issuedBy   User      @relation("IssuedBy", fields: [issuedById], references: [id])
  consumedBy User?     @relation("ConsumedBy", fields: [consumedById], references: [id])
  logs       AvoirLog[]

  @@index([issuedToId])
  @@index([status])
  @@index([code])
}

model AvoirLog {
  id        Int         @id @default(autoincrement())
  avoirId   Int
  userId    Int
  action    AvoirAction
  metadata  Json?
  createdAt DateTime    @default(now())

  avoir Avoir @relation(fields: [avoirId], references: [id])
  user  User  @relation(fields: [userId], references: [id])

  @@index([avoirId])
  @@index([userId])
  @@index([action])
}

model StockItem {
  id               Int      @id @default(autoincrement())
  name             String
  description      String?
  quantity         Int      @default(0)
  unit             String
  alertThreshold   Int      @default(0)
  category         String?
  isBuvette        Boolean  @default(false)
  priceCents       Int      @default(0)
  lastUpdatedById  Int?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  deletedAt        DateTime?

  lastUpdatedBy User?              @relation(fields: [lastUpdatedById], references: [id])
  movements     StockMovement[]
  venteItems    BuvetteVenteItem[]

  @@index([category])
  @@index([quantity])
}

model StockMovement {
  id          Int      @id @default(autoincrement())
  stockItemId Int
  userId      Int
  delta       Int
  reason      String?
  createdAt   DateTime @default(now())

  stockItem StockItem @relation(fields: [stockItemId], references: [id])
  user      User      @relation(fields: [userId], references: [id])

  @@index([stockItemId])
  @@index([userId])
}

model Event {
  id            Int         @id @default(autoincrement())
  title         String
  description   String?
  date          DateTime
  location      String?
  status        EventStatus @default(IDEE)
  budgetCents   Int         @default(0)
  spentCents    Int         @default(0)
  responsibleId Int?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  deletedAt     DateTime?

  responsible        User?               @relation(fields: [responsibleId], references: [id])
  tasks              EventTask[]
  communicationPosts CommunicationPost[]

  @@index([status])
  @@index([date])
  @@index([responsibleId])
}

model EventTask {
  id           Int        @id @default(autoincrement())
  eventId      Int
  assignedToId Int?
  title        String
  description  String?
  status       TaskStatus @default(A_FAIRE)
  dueDate      DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  deletedAt    DateTime?

  event      Event @relation(fields: [eventId], references: [id])
  assignedTo User? @relation(fields: [assignedToId], references: [id])

  @@index([eventId])
  @@index([assignedToId])
  @@index([status])
}

model Partner {
  id             Int           @id @default(autoincrement())
  name           String
  contactName    String?
  contactEmail   String?
  contactPhone   String?
  status         PartnerStatus @default(PROSPECT)
  category       String?
  dealDescription String?
  notes          String?
  responsibleId  Int?
  fileUrls       String[]
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  deletedAt      DateTime?

  responsible User? @relation(fields: [responsibleId], references: [id])

  @@index([status])
  @@index([responsibleId])
}

model CommunicationPost {
  id            Int        @id @default(autoincrement())
  platform      Platform
  title         String
  caption       String?
  status        PostStatus @default(IDEE)
  scheduledAt   DateTime?
  publishedAt   DateTime?
  responsibleId Int?
  eventId       Int?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  deletedAt     DateTime?

  responsible User?  @relation(fields: [responsibleId], references: [id])
  event       Event? @relation(fields: [eventId], references: [id])

  @@index([platform])
  @@index([status])
  @@index([responsibleId])
}

model LockCode {
  id           Int      @id @default(autoincrement())
  code         String
  updatedAt    DateTime @updatedAt
  updatedById  Int?

  updatedBy User? @relation(fields: [updatedById], references: [id])
}

model LockAccessLog {
  id         Int      @id @default(autoincrement())
  userId     Int
  accessedAt DateTime @default(now())
  ipAddress  String?

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([accessedAt])
}

model AuditLog {
  id        Int      @id @default(autoincrement())
  userId    Int
  action    String
  entity    String
  entityId  Int?
  metadata  Json?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([entity])
  @@index([createdAt])
}

model BuvetteVente {
  id            Int           @id @default(autoincrement())
  totalCents    Int
  paymentMethod PaymentMethod
  avoirCode     String?
  vendeurId     Int
  createdAt     DateTime      @default(now())

  vendeur User              @relation(fields: [vendeurId], references: [id])
  items   BuvetteVenteItem[]

  @@index([vendeurId])
  @@index([createdAt])
  @@index([paymentMethod])
}

model BuvetteVenteItem {
  id          Int @id @default(autoincrement())
  venteId     Int
  stockItemId Int
  quantity    Int
  priceCents  Int

  vente     BuvetteVente @relation(fields: [venteId], references: [id])
  stockItem StockItem    @relation(fields: [stockItemId], references: [id])

  @@index([venteId])
  @@index([stockItemId])
}

model TresoTransaction {
  id          Int       @id @default(autoincrement())
  type        TresoType
  amountCents Int
  category    String?
  description String
  date        DateTime
  invoiceUrl  String?
  createdById Int
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  createdBy User @relation(fields: [createdById], references: [id])

  @@index([type])
  @@index([date])
  @@index([createdById])
}
