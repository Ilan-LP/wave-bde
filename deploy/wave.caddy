# Site block for the Wave backend — ADDITIVE ONLY.
#
# This machine already runs a separate Caddy instance (as a Docker
# container) for another, unrelated project, using a single Caddyfile.
# This file is NOT a standalone Caddyfile and must never be run on its
# own — append its contents into that existing Caddyfile instead, then
# reload/restart that existing Caddy container. Do not duplicate the
# existing global options block (the `{ email ... }` block at the top of
# a Caddyfile) — a Caddyfile may only have one, and that project's
# Caddyfile already has it. Do not touch or assume anything else about
# that existing Caddyfile's content beyond appending this block to it.
#
# DNS-01 challenge against Cloudflare is used (not HTTP-01) because this
# machine is a home connection without a guaranteed static IP — see
# CLAUDE.md's Deployment section and DEPLOY.md. This assumes the existing
# Caddy binary already has the caddy-dns/cloudflare module built in
# (confirmed true for this machine as of 2026-09-07 — re-verify if that
# Caddy instance is ever rebuilt/replaced).
#
# {$DOMAIN}, {$CF_API_TOKEN}, {$BACKEND_PORT} must resolve to real values
# in the *existing* Caddy container's own environment for this env-var
# substitution syntax to work — either add these three vars to that
# container's environment, or replace the placeholders below with literal
# values directly. See DEPLOY.md.

{$DOMAIN} {
	tls {
		dns cloudflare {$CF_API_TOKEN}
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
	}

	# wave-backend-prod is this repo's backend container_name
	# (docker-compose.prod.yml) — reachable here only because that compose
	# file attaches it to the same external Docker network the existing
	# Caddy container already runs on (see docker-compose.prod.yml's
	# `caddy_net` network and DEPLOY.md).
	reverse_proxy wave-backend-prod:{$BACKEND_PORT}
}
