# Copy this file to .env (git-ignored) for local development.
# Vite only reads real env files, not this .env.example.
#
# The local backend URL (apps/backend/.env's PORT is 3000 by default).
VITE_API_URL=http://localhost:3000

# This app's own local dev port is 5178 (see vite.config.ts) — make sure
# apps/backend/.env's CORS_ORIGINS includes http://localhost:5178.
