PORT=3000

# Used by Prisma (schema.prisma) when running `prisma migrate`/`prisma generate`
# locally, and by the app at runtime to connect to Postgres. Matches the
# docker-compose Postgres service defaults — see root .env.example.
DATABASE_URL=postgresql://wave:wave_dev_password@localhost:5432/wave_dev

# Required — the server refuses to start without these (see src/config/env.ts).
# Generate real values with: openssl rand -hex 32
JWT_SECRET=changeme-generate-with-openssl-rand-hex-32
JWT_REFRESH_SECRET=changeme-generate-a-different-value-with-openssl-rand-hex-32

# Required — the server refuses to start without this (see src/config/env.ts).
# Comma-separated list of allowed frontend origins (no trailing slash), e.g.
# the Vite dev servers below.
CORS_ORIGINS=http://localhost:5173

# Optional (see src/config/env.ts and src/jobs/ "Audit Log Export") — the
# server boots fine without these, and the daily export job just skips/no-ops
# with a log message instead of running. Set both to actually enable the
# Drive backup. Full contents of a Google Cloud service account key file
# (Drive API enabled, drive.file scope), minified to one line, and the ID of
# the Drive folder it should upload exports to — shared with that service
# account's client_email.
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","client_email":"...","private_key":"..."}
GOOGLE_DRIVE_FOLDER_ID=changeme-google-drive-folder-id

# Optional (see src/config/env.ts and src/lib/sumup.ts) — the server boots
# fine without these; POST /me/recharge just 503s instead of running. Set
# all three to actually enable self-service points recharge. A SumUp OAuth
# client-credentials pair and the merchant code that should receive the
# payment.
SUMUP_CLIENT_ID=changeme-sumup-client-id
SUMUP_CLIENT_SECRET=changeme-sumup-client-secret
SUMUP_MERCHANT_CODE=changeme-sumup-merchant-code
