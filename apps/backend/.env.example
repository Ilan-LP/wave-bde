PORT=3000

# Used by Prisma (schema.prisma) when running `prisma migrate`/`prisma generate`
# locally, and by the app at runtime to connect to Postgres. Matches the
# docker-compose Postgres service defaults — see root .env.example.
DATABASE_URL=postgresql://wave:wave_dev_password@localhost:5432/wave_dev

# Required — the server refuses to start without these (see src/config/env.ts).
# Generate real values with: openssl rand -hex 32
JWT_SECRET=changeme-generate-with-openssl-rand-hex-32
JWT_REFRESH_SECRET=changeme-generate-a-different-value-with-openssl-rand-hex-32
