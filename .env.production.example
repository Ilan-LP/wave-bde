# Copy this file to .env.production on the deployment machine and fill in
# real values. .env.production is git-ignored — never commit real secrets.
#
# Consumed by docker-compose.prod.yml (Postgres + migrate + backend + the 6
# frontends). Unlike .env.example (dev), none of the secrets below have
# insecure defaults baked into docker-compose.prod.yml — every required one
# must be set explicitly, or the relevant service refuses to start.
#
# This deploys onto a shared machine that already runs other projects (e.g.
# "dolibarr") behind one edge Caddy instance, with TLS terminated upstream
# by an existing cloudflared tunnel — this repo does not run its own Caddy
# or handle certs. See CLAUDE.md's Deployment section and DEPLOY.md.

# ---- PostgreSQL (docker-compose service `db`) ----
POSTGRES_USER=wave
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_DB=wave_prod

# ---- Backend (apps/backend) ----
# Port the backend listens on inside its container. Not published to the
# host — only Postgres (internal network) and the shared edge Caddy (edge
# network, see below) reach it, both over Docker networks.
BACKEND_PORT=3000

# Required by apps/backend/src/config/env.ts — the backend refuses to start
# if either is missing, empty, or identical to each other. Generate with:
# openssl rand -hex 32
JWT_SECRET=replace-with-a-long-random-string
JWT_REFRESH_SECRET=replace-with-a-different-long-random-string

# ---- CORS ----
# Required by apps/backend/src/config/env.ts. Comma-separated list of
# allowed frontend origins (no trailing slash) — this deployment's 6
# frontend subdomains, plus a local-dev origin if you also test against
# this backend from a Vite dev server:
# CORS_ORIGINS=https://bde-wave.com,https://bureau.bde-wave.com,https://buvette.bde-wave.com,https://comm.bde-wave.com,https://events.bde-wave.com,https://partenariats.bde-wave.com,http://localhost:5173
CORS_ORIGINS=

# ---- Audit Log Export (Google Drive) ----
# Optional (apps/backend/src/config/env.ts) — the backend boots fine
# without these; the daily export job just skips/no-ops with a log message
# instead of running. Set both to actually enable the Drive backup. Full
# contents of a Google Cloud service account key file (Drive API enabled,
# drive.file scope), minified to one line. GOOGLE_DRIVE_FOLDER_ID is the
# target Drive folder's ID — it must be shared with that service account's
# client_email.
GOOGLE_SERVICE_ACCOUNT_JSON=replace-with-minified-service-account-json
GOOGLE_DRIVE_FOLDER_ID=replace-with-google-drive-folder-id

# ---- Frontend build (Vite) ----
# Passed as a Docker build ARG (not a runtime env var) to each of the 6
# frontend Dockerfiles — see docker-compose.prod.yml's `build.args` per
# frontend service and apps/<app>/src/lib/api.ts. Baked into the static
# build at image-build time; changing it requires rebuilding the images.
VITE_API_URL=https://api.bde-wave.com

# ---- Reverse proxy (existing shared edge Caddy — not run by this repo) ----
# This machine already runs a shared Caddy instance (Docker container) for
# multiple projects, with one `.caddy` site file per project under
# /opt/proxy/caddy/sites/. TLS is terminated upstream by an existing
# cloudflared tunnel in front of that Caddy — this repo has no TLS/cert
# config of its own. docker-compose.prod.yml attaches every service that
# needs to be reverse-proxied to an external `edge` Docker network (fixed
# name, not configurable here) that the shared Caddy is already attached
# to — confirm it exists on the machine before deploying (`docker network
# ls`). See DEPLOY.md and deploy/sites.reference.caddy.

# Wildcard domain this deployment serves under (*.bde-wave.com). Not read
# by anything in this repo — documented here only as a reference for
# writing the real per-project Caddy site file(s) manually, per DEPLOY.md.
# DOMAIN=bde-wave.com
