# Copy this file to .env.production on the deployment machine and fill in
# real values. .env.production is git-ignored — never commit real secrets.
#
# Consumed by docker-compose.prod.yml (Postgres + backend). Unlike
# .env.example (dev), none of the secrets below have insecure defaults
# baked into docker-compose.prod.yml — every one of these must be set
# explicitly, or the relevant service refuses to start. A few (see the
# reverse-proxy section below) aren't read by this repo's compose file at
# all — this machine already runs a separate Caddy instance for another
# project, and this deployment integrates with it rather than running its
# own; see docker-compose.prod.yml and deploy/wave.caddy.

# ---- PostgreSQL (docker-compose service) ----
POSTGRES_USER=wave
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_DB=wave_prod

# ---- Backend (apps/backend) ----
# Port the backend listens on inside its container. Not published to the
# host in production — only Postgres (default network) and the existing
# Caddy container (caddy_net, see below) reach it, both over Docker
# networks.
BACKEND_PORT=3000

# Required by apps/backend/src/config/env.ts — the backend refuses to start
# if either is missing, empty, or identical to each other. Generate with:
# openssl rand -hex 32
JWT_SECRET=replace-with-a-long-random-string
JWT_REFRESH_SECRET=replace-with-a-different-long-random-string

# ---- Audit Log Export (Google Drive) ----
# Also required by apps/backend/src/config/env.ts (same fail-fast as
# above). Full contents of a Google Cloud service account key file (Drive
# API enabled, drive.file scope), minified to one line.
# GOOGLE_DRIVE_FOLDER_ID is the target Drive folder's ID — it must be
# shared with that service account's client_email.
GOOGLE_SERVICE_ACCOUNT_JSON=replace-with-minified-service-account-json
GOOGLE_DRIVE_FOLDER_ID=replace-with-google-drive-folder-id

# ---- Reverse proxy integration (existing Caddy instance) ----
# This machine already runs a separate Caddy container for another,
# unrelated project — this deployment does NOT run its own Caddy service
# (see docker-compose.prod.yml and deploy/wave.caddy). These vars are
# still declared here for reference, but are consumed differently than a
# typical docker-compose.prod.yml var — see the comment on each.

# Docker network name the existing Caddy container is already attached
# to. docker-compose.prod.yml's backend service joins this network (as an
# `external: true` network) so that existing Caddy can reach it by
# container name. PLACEHOLDER — confirm the real network name on the
# actual machine (e.g. `docker network ls`, or inspect the existing Caddy
# container) before deploying.
CADDY_EXTERNAL_NETWORK=caddy_net

# Public domain name this deployment serves, e.g. wave.example.org. Not
# read by docker-compose.prod.yml directly — it belongs in the site block
# added to the existing Caddy's Caddyfile (see deploy/wave.caddy), and if
# using Caddy's env-var substitution there, must be set in that existing
# Caddy container's own environment instead. PLACEHOLDER — replace with
# the real domain once one is registered/chosen, with its DNS zone
# managed on Cloudflare.
DOMAIN=wave.example.org

# Cloudflare API token for the DNS-01 challenge in deploy/wave.caddy's
# `tls { dns cloudflare ... }` block — needed because this deploys to a
# home connection without a guaranteed static IP/reachable port 80. Same
# caveat as DOMAIN above: needs to end up in the existing Caddy
# container's own environment (or be substituted directly into the site
# block), not read by this repo's own compose file. Scope the token to
# "Zone:DNS:Edit" for DOMAIN's zone only (Cloudflare dashboard -> My
# Profile -> API Tokens -> Create Token -> "Edit zone DNS" template) — do
# not use the account-wide Global API Key.
CF_API_TOKEN=replace-with-a-scoped-cloudflare-api-token
