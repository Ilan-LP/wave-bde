# Copy this file to .env and adjust values as needed.
# .env is git-ignored — never commit real secrets.
#
# These variables are consumed by docker-compose.yml (Postgres + backend
# container). No Prisma schema/migrations exist yet — DATABASE_URL is wired
# up for when that lands.

# ---- PostgreSQL (docker-compose service) ----
# Dev-only default credentials. Change them for anything beyond local dev.
POSTGRES_USER=wave
POSTGRES_PASSWORD=wave_dev_password
POSTGRES_DB=wave_dev
# Host port Postgres is exposed on. Change if 5432 is already in use locally.
POSTGRES_PORT=5432

# ---- Backend (apps/backend) ----
# Port the backend listens on inside its container, and the host port it's
# published on (docker-compose maps them 1:1).
BACKEND_PORT=3000

# Host-side reference only (e.g. running `prisma` commands directly on your
# machine against the containerized DB). Inside the backend container,
# docker-compose builds the equivalent value itself using the postgres
# service's hostname — this line is not read by the container.
DATABASE_URL=postgresql://wave:wave_dev_password@localhost:5432/wave_dev

# ---- Auth (JWT) ----
# Required by apps/backend/src/config/env.ts — the backend refuses to start
# if either is missing or empty. Generate long random strings (e.g.
# `openssl rand -hex 32`), do not reuse across envs.
JWT_SECRET=replace-with-a-long-random-string
JWT_REFRESH_SECRET=replace-with-a-different-long-random-string

# ---- Audit Log Export (Google Drive) ----
# Also required by apps/backend/src/config/env.ts (same fail-fast as the JWT
# secrets above). GOOGLE_SERVICE_ACCOUNT_JSON is the full contents of a
# Google Cloud service account key file (Drive API enabled, drive.file
# scope), minified to one line. GOOGLE_DRIVE_FOLDER_ID is the target Drive
# folder's ID — it must be shared with that service account's client_email.
GOOGLE_SERVICE_ACCOUNT_JSON=replace-with-minified-service-account-json
GOOGLE_DRIVE_FOLDER_ID=replace-with-google-drive-folder-id
